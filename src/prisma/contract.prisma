
model User {
  id              String     @id @default(uuid())
  name            String
  avatar          String?
  timezone        String?
  deliveryWindows Int[]
  createdAt       DateTime   @default(now())
  posts           Post[]
  reactions       Reaction[]
  saves           Save[]
  replies         Reply[]
  topicFollows    TopicFollow[]
  feedSessions    FeedSession[]
  seenPosts       PostSeen[]
  restatements    Restatement[] @relation("restater")

  sentMessages    Message[]     @relation("sender")
  receivedMessages Message[]    @relation("recipient")
  
  memberships     Membership[]
  roomMessages    RoomMessage[]

  // ── Veda Verse product profile ──
  email           String?    @unique
  handle          String?    @unique
  initials        String?
  hue             Int        @default(60)
  line            String?
  credential      String?
  isEditor        Boolean    @default(false)
  brings          String?
  openTo          String     @default("Answering questions")
  quietHours      Boolean    @default(true)
  digest          String     @default("Daily")
  keepHistory     Boolean    @default(true)
  onboardedAt     DateTime?
  lastSeenAt      DateTime?

  expertise       Expertise[]
  notes           Note[]
  questions       Question[]
  answers         Answer[]
  responses       Response[]
  following       Follow[]      @relation("follower")
  followers       Follow[]      @relation("followee")
  notifications   Notification[] @relation("recipient")
  actedNotifications Notification[] @relation("actor")
  drafts          Draft[]
  collections     Collection[]
  @@rls
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  mark      String
  kind      String
  createdAt DateTime @default(now())
  posts     Post[]
  @@rls
}

model Topic {
  id    String @id @default(uuid())
  name  String @unique
  posts   Post[]
  follows TopicFollow[]

  expertise   Expertise[]
  notes       Note[]
  questions   Question[]
  articles    Article[]
  communities CommunityTopic[]
  @@rls
}

model Post {
  id           String        @id @default(uuid())
  title        String?
  body         String?
  type         String        // "Text", "Image", "Poll", "Video", "Link", "Question"
  kind         String?       // "q", "fact", "ctx", "exp", "int", "trad", "bel", "spec"
  topicId      String
  topic        Topic         @relation(fields: [topicId], references: [id])
  
  // Relations: A post can belong to a User OR an Organization
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  
  // Additional fields for specific post types/features
  art          String?
  cap          String?
  sgi          Boolean       @default(false)
  src          String?       // Used by facts/links
  why          String?       // Used by organization posts
  likesCount   Int           @default(0) // The 'n' metric (e.g. 2.3K) mapped to Int for real data

  aiAssisted   Boolean       @default(false)
  aiAssistedNote String?

  discussGateOn Boolean      @default(false)
  gateReasonHint String?

  createdAt    DateTime      @default(now())
  
  reactions    Reaction[]
  saves        Save[]
  replies      Reply[]
  pollOptions  PollOption[]
  feedItems    FeedItem[]
  seenBy       PostSeen[]
  restatements Restatement[]
  @@rls
}

model Reply {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  parentReplyId String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String
  body      String

  restatementId String?      @unique
  restatement   Restatement? @relation(fields: [restatementId], references: [id])
  state         String       @default("SEALED") // SEALED, PUBLISHED, RETRACTED
  publishedAt   DateTime?
  sourceId      String?

  reactions Reaction[]
  restatements  Restatement[] @relation("restatedReply")
  createdAt DateTime @default(now())
  @@rls
}

model Restatement {
  id            String   @id @default(uuid())
  parentPostId  String?
  parentReplyId String?
  parentPost    Post?    @relation(fields: [parentPostId], references: [id])
  parentReply   Reply?   @relation("restatedReply", fields: [parentReplyId], references: [id])

  restaterId    String
  restater      User     @relation("restater", fields: [restaterId], references: [id])

  text          String
  wordCount     Int
  state         String   @default("DRAFT") // DRAFT, PENDING, ACCEPTED, RETURNED, WITHDRAWN, EXPIRED

  submittedAt   DateTime?
  decidedAt     DateTime?
  decidedById   String?
  returnNote    String?
  expiresAt     DateTime?

  reply         Reply?
  @@rls
}

model Reaction {
  id        String   @id @default(uuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id])
  replyId   String?
  reply     Reply?   @relation(fields: [replyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String   // "HELPFUL", "RELATABLE", "CHANGED_MY_MIND", "WELL_SOURCED"
  createdAt DateTime @default(now())

  @@unique([postId, userId, kind])
  @@unique([replyId, userId, kind])
  @@rls
}

model Save {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  folder    String   @default("Read later")
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@rls
}

model PollOption {
  id        String @id @default(uuid())
  postId    String
  post      Post   @relation(fields: [postId], references: [id])
  text      String
  votes     Int    @default(0)
  pollVotes PollVote[]
  @@rls
}

model PollVote {
  id        String   @id @default(uuid())
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([optionId, userId]) // one vote per option per user
  @@rls
}

model Reel {
  id        String   @id @default(uuid())
  title     String
  subtitle  String
  duration  String
  createdAt DateTime @default(now())
  @@rls
}

model TopicFollow {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, topicId])
  @@rls
}

model FeedSession {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  highWaterMark DateTime
  itemCount     Int
  openedAt      DateTime   @default(now())
  items         FeedItem[]
  @@rls
}

model FeedItem {
  id        String      @id @default(uuid())
  sessionId String
  session   FeedSession @relation(fields: [sessionId], references: [id])
  postId    String
  post      Post        @relation(fields: [postId], references: [id])
  position  Int
  isOrg     Boolean
  reason    String
  @@rls
}

model MessageThread {
  id           String    @id @default(uuid())
  participants String[]
  lastActivity DateTime  @default(now())
  @@rls
}

model Message {
  id             String    @id @default(uuid())
  threadId       String
  senderId       String
  recipientId    String
  sender         User      @relation("sender", fields: [senderId], references: [id])
  recipient      User      @relation("recipient", fields: [recipientId], references: [id])

  body           String
  attachedPostId String?

  state          String    @default("QUEUED") // QUEUED, DELIVERED, READ, WITHDRAWN
  createdAt      DateTime  @default(now())

  scheduledFor   DateTime
  deliveredAt    DateTime?
  readAt         DateTime?
  sentNow        Boolean   @default(false)
  heldByQuiet    Boolean   @default(false)

  @@index([recipientId, state, scheduledFor])
  @@index([threadId, createdAt])
  @@rls
}

model PostSeen {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  seenAt    DateTime @default(now())

  @@unique([userId, postId])
  @@rls
}

model Community {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  blurb     String?
  createdAt DateTime @default(now())
  rooms     Room[]
  members   Membership[]

  // Circle | Board | Cohort | Practice
  format       String   @default("Circle")
  // kept | fades | members — what happens to what people write here
  memory       String   @default("kept")
  fadeDays     Int?
  pace         String?
  contributors String?
  weekPrompt   String?
  weekDetail   String?
  rules        String[]

  topics    CommunityTopic[]
  threads   CommunityThread[]
  notes     Note[]
  questions Question[]
  @@rls
}

model Room {
  id          String   @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  name        String
  key         String
  iconSymbol  String
  accentToken String

  speech      String
  memory      String
  pace        String
  whoSpeaks   String
  modeLabel   String
  ruleNote    String
  invitation  String?

  retentionHours Int?
  createdAt   DateTime @default(now())

  messages    RoomMessage[]
  
  @@unique([communityId, key])
  @@rls
}

model Membership {
  userId      String
  communityId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  isSteward   Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  // member | applied (a Cohort takes applications)
  status      String    @default("member")
  
  @@id([userId, communityId])
  @@rls
}

model RoomMessage {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  refLabel  String?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  
  @@index([roomId, createdAt])
  @@index([expiresAt])
  @@rls
}


// ══════════════════════════════════════════════════════════════════════
// Veda Verse — the product
// Five labels say what a contribution rests on: asking, documented, lived,
// told, view. No public counts are stored anywhere a reader can see them.
// ══════════════════════════════════════════════════════════════════════

// "Ask me about" — up to three topics a member answers questions on.
model Expertise {
  userId  String
  topicId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@rls
}

model CommunityTopic {
  communityId String
  topicId     String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([communityId, topicId])
  @@rls
}

model CommunityThread {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String?
  pinned      Boolean   @default(false)
  isCurrent   Boolean   @default(false)
  // notes stay hidden until a member says they have read this far
  spoiler     Boolean   @default(false)
  archived    Boolean   @default(false)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  notes       Note[]
  unlocks     SpoilerUnlock[]

  @@index([communityId])
  @@rls
}

model SpoilerUnlock {
  userId   String
  threadId String
  thread   CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, threadId])
  @@rls
}

// A shared post, in public under a topic or inside a community thread.
model Note {
  id            String    @id @default(uuid())
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body          String
  // documented | lived | told | view
  basis         String
  topicId       String?
  topic         Topic?    @relation(fields: [topicId], references: [id])
  communityId   String?
  community     Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  threadId      String?
  thread        CommunityThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  buildsOnId    String?
  buildsOn      Note?     @relation("buildsOn", fields: [buildsOnId], references: [id], onDelete: SetNull)
  builtOnBy     Note[]    @relation("buildsOn")
  sourceUrl     String?
  sourceType    String?
  sourceLocator String?
  aiAssisted    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  editedAt      DateTime?

  responses     Response[]

  @@index([authorId])
  @@index([topicId])
  @@index([communityId])
  @@index([threadId])
  @@index([createdAt])
  @@rls
}

model Question {
  id               String    @id @default(uuid())
  askerId          String
  asker            User      @relation(fields: [askerId], references: [id], onDelete: Cascade)
  title            String
  context          String?
  topicId          String
  topic            Topic     @relation(fields: [topicId], references: [id])
  communityId      String?
  community        Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  acceptedAnswerId String?
  aiAssisted       Boolean   @default(false)
  createdAt        DateTime  @default(now())

  answers          Answer[]
  followers        QuestionFollow[]

  @@index([askerId])
  @@index([topicId])
  @@index([createdAt])
  @@rls
}

model Answer {
  id            String    @id @default(uuid())
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Answers | Builds on | Disagrees
  relation      String    @default("Answers")
  basis         String
  body          String
  onAnswerId    String?
  onAnswer      Answer?   @relation("answerBuildsOn", fields: [onAnswerId], references: [id], onDelete: SetNull)
  builtOnBy     Answer[]  @relation("answerBuildsOn")
  reason        String?
  sourceUrl     String?
  sourceType    String?
  sourceLocator String?
  createdAt     DateTime  @default(now())

  @@index([questionId])
  @@index([authorId])
  @@rls
}

model QuestionFollow {
  userId     String
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  following  Boolean  @default(true)
  // "I have this question too" — counted for the asker alone
  same       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@id([userId, questionId])
  @@rls
}

// A piece written and edited by the house, with its record and its lore
// kept apart.
model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  dek         String?
  topicId     String
  topic       Topic     @relation(fields: [topicId], references: [id])
  editorName  String
  image       String?
  readMinutes Int       @default(5)
  documented  String?
  told        String?
  carry       String?
  related     String[]
  publishedAt DateTime  @default(now())
  updatedAt   DateTime?

  paragraphs  ArticleParagraph[]
  sources     ArticleSource[]
  corrections ArticleCorrection[]
  suggestions CorrectionSuggestion[]
  responses   Response[]

  @@index([topicId])
  @@rls
}

model ArticleParagraph {
  id        String  @id @default(uuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  position  Int
  text      String
  sourceNumber Int?

  @@index([articleId])
  @@rls
}

model ArticleSource {
  id        String  @id @default(uuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  type      String
  locator   String?
  url       String?
  checks    SourceCheck[]

  @@unique([articleId, number])
  @@rls
}

model ArticleCorrection {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([articleId])
  @@rls
}

model CorrectionSuggestion {
  id        String   @id @default(uuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())

  @@index([articleId])
  @@rls
}

// A reader's verdict on one source: Supports it | Partly | Doesn't | Can't access
model SourceCheck {
  userId    String
  sourceId  String
  source    ArticleSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  verdict   String
  createdAt DateTime @default(now())

  @@id([userId, sourceId])
  @@rls
}

// A reply to a note or an article, grouped by how it relates.
model Response {
  id           String    @id @default(uuid())
  authorId     String
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  noteId       String?
  note         Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  articleId    String?
  article      Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // Adds context | Builds on | Disagrees | Asks
  relation     String
  basis        String
  anchor       String?
  onResponseId String?
  onResponse   Response? @relation("responseBuildsOn", fields: [onResponseId], references: [id], onDelete: SetNull)
  builtOnBy    Response[] @relation("responseBuildsOn")
  reason       String?
  body         String
  createdAt    DateTime  @default(now())

  @@index([noteId])
  @@index([articleId])
  @@rls
}

model Follow {
  followerId String
  followeeId String
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@rls
}

model Mute {
  userId  String
  mutedId String
  createdAt DateTime @default(now())

  @@id([userId, mutedId])
  @@rls
}

model Block {
  userId    String
  blockedId String
  createdAt DateTime @default(now())

  @@id([userId, blockedId])
  @@rls
}

// "Not interested" — hides one item from this member's feed.
model Hide {
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@id([userId, targetType, targetId])
  @@rls
}

// Private: the author is told, nobody sees a total.
model Helpful {
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@id([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@rls
}

model Bookmark {
  userId     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@id([userId, targetType, targetId])
  @@rls
}

model Collection {
  id         String   @id @default(uuid())
  ownerId    String
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  // private | a community id it is shared with
  visibility String   @default("private")
  createdAt  DateTime @default(now())
  items      CollectionItem[]

  @@index([ownerId])
  @@rls
}

model CollectionItem {
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  targetType   String
  targetId     String
  addedAt      DateTime   @default(now())

  @@id([collectionId, targetType, targetId])
  @@rls
}

model Draft {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text          String
  intent        String?
  basis         String?
  topicName     String?
  audience      String?
  sourceUrl     String?
  sourceType    String?
  sourceLocator String?
  aiAssisted    Boolean  @default(false)
  updatedAt     DateTime @default(now())

  @@index([userId])
  @@rls
}

model ReadEvent {
  userId     String
  targetType String
  targetId   String
  title      String
  readAt     DateTime @default(now())

  @@id([userId, targetType, targetId])
  @@index([userId, readAt])
  @@rls
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  communityId String?
  status      String   @default("open")
  createdAt   DateTime @default(now())

  @@index([status])
  @@rls
}

// The Inbox. Answers, builds-on, mentions and thanks arrive right away
// (outside quiet hours); circle activity waits for the digest.
model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  // Answers | Builds on | Mentions | Thanks | Communities
  type        String
  actorId     String?
  actor       User?     @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  text        String
  preview     String?
  href        String
  replyType   String?
  replyId     String?
  digestKey   String?
  deliverAt   DateTime  @default(now())
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, deliverAt])
  @@index([digestKey])
  @@rls
}

// The early list on the landing page. An address counts once its owner
// confirms from their inbox; unconfirmed ones are deleted after 30 days.
model EarlyListEntry {
  id            String    @id @default(uuid())
  email         String    @unique
  token         String    @unique
  confirmedAt   DateTime?
  confirmSentAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@rls
}
