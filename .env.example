# Copy to .env and fill in what you have (the Prisma CLI and the seed script
# read .env too, so prefer it over .env.local). Every value is
# optional: with none of them set, the landing page still works (its demos
# run in the browser) and nothing is written anywhere.

# Postgres (15+): the product, and the landing page's early list.
DATABASE_URL=postgres://user:password@localhost:5432/myveda

# Supabase project for email magic-link sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The site's public address: sign-in email links, canonical/share tags,
# robots.txt and the sitemap. Defaults to https://myvedaverse.in in
# production and http://localhost:3000 in development. See DEPLOY.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo sign-in: pick a seeded member at /signin without an email. On by
# default in development, off in production unless set to 1. Never enable it
# on a real deployment.
# DEMO_LOGIN=1

# Outgoing email for the early list's confirmation messages. Without these,
# addresses are saved but no confirmation is sent. With GoDaddy email:
# smtpout.secureserver.net, port 465, and the mailbox's address and password.
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_USER=admin@myvedaverse.in
# SMTP_PASS=mailbox-password
# SMTP_FROM="My Veda Verse <admin@myvedaverse.in>"
